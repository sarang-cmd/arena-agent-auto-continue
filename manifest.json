{
  "manifest_version": 3,
  "name": "Arena Agent Auto-Continue",
  "version": "1.0.0",
  "description": "Automatically sends \"continue\" when the Arena agent reaches its per-turn tool-call limit.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "https://*.arena.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena Agent Auto-Continue"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}