{
  "manifest_version": 3,
  "name": "Baton",
  "version": "1.3.1",
  "description": "Sends \"continue\" when the Arena agent hits its tool-call limit for the turn.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "https://*.arena.ai/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "Baton settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ],
      "js": [
        "notifications/events.js",
        "notifications/observe.js",
        "ui/settings.js",
        "ui/panel.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_permissions": []
}
